#!/bin/bash
# Post-install script for the Rane SL 3 macOS Driver

chown -R root:wheel "/Library/Audio/Plug-Ins/HAL/SL3Device.driver"
chmod -R 755 "/Library/Audio/Plug-Ins/HAL/SL3Device.driver"

chown -R root:wheel "/Library/Frameworks/Sl3Api.framework"
chmod -R 755 "/Library/Frameworks/Sl3Api.framework"

chown -R root:wheel "/Applications/SL 3 Control Panel.app"
chmod -R 755 "/Applications/SL 3 Control Panel.app"

chown -R root:wheel "/Library/Extensions/Sl3Driver.10.9.kext"
chmod -R 755 "/Library/Extensions/Sl3Driver.10.9.kext"

for tool in sl3panel sl3dump sl3flash; do
    if [ -f "/usr/local/bin/$tool" ]; then
        chown root:wheel "/usr/local/bin/$tool"
        chmod 755 "/usr/local/bin/$tool"
    fi
done

# Remove quarantine attributes if present
xattr -dr com.apple.quarantine "/Library/Audio/Plug-Ins/HAL/SL3Device.driver" 2>/dev/null || true
xattr -dr com.apple.quarantine "/Library/Frameworks/Sl3Api.framework" 2>/dev/null || true
xattr -dr com.apple.quarantine "/Applications/SL 3 Control Panel.app" 2>/dev/null || true

# Restart CoreAudio daemon so the SL 3 HAL driver loads immediately without rebooting
killall -9 coreaudiod 2>/dev/null || launchctl kickstart -kp system/com.apple.audio.coreaudiod 2>/dev/null || true

exit 0
